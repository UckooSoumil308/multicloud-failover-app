# =============================================================================
# Multi-Cloud Failover Application - Environment Configuration Example
# =============================================================================

# Server Port (Azure App Service sets PORT dynamically; AWS Elastic Beanstalk defaults to 8080)
PORT=8080

# Cloud Origin Metadata (displayed on the Control Tower dashboard & tagged on logs)
# Options: AZURE-PRIMARY, AWS-SECONDARY, or LOCAL-DEV
CLOUD_PROVIDER=AZURE-PRIMARY

# Cloud Region Code (e.g., eastus, us-east-1, local)
CLOUD_REGION=eastus

# Shared PostgreSQL Connection String (Neon.tech, Supabase, or RDS Free Tier)
# If omitted or left empty, the application seamlessly falls back to an in-memory data store.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

